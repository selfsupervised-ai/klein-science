# provenance: original
# The SymPy oracle image (CONF-01). Offline only: it runs at build or test time through
# `cargo xtask oracle run`, and nothing from it is shipped or linked (CLAUDE.md rule 3).
# Built and pinned per platform with `cargo xtask oracle build-image sympy --platform <p>`.
FROM python:3.13-slim-trixie@sha256:70729b46c69b4f1e97c4822c1af3df53a1476cf5ddc6c087c0c10bc3a5678c2f

# PYTHONHASHSEED is deliberately absent: xtask sets it per run (--seed).
ENV PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 SYMPY_GROUND_TYPES=python MPMATH_NOGMPY=1 SYMPY_USE_CACHE=yes LC_ALL=C.UTF-8 TZ=UTC

# Operator-approved lock (plan 01-05 Task 2): sympy 1.14.0 and mpmath 1.3.0, wheels only,
# every distribution checked against its hash.
COPY requirements.lock /tmp/requirements.lock
RUN pip install --disable-pip-version-check --root-user-action=ignore --no-deps --require-hashes --only-binary=:all: -r /tmp/requirements.lock \
 && rm /tmp/requirements.lock

# No accelerated backend may be present: gmpy2 or python-flint would change the ground types,
# and numpy would change what some programs can import.
RUN python -c "import importlib.metadata as m; names = sorted({d.metadata['Name'].lower() for d in m.distributions()}); bad = set(names) & {'gmpy2', 'python-flint', 'numpy'}; assert not bad, bad; print(names)"

USER 65534:65534
